{
  "name": "niti-app",
  "productName": "niti",
  "version": "0.1.1",
  "description": "The niti desktop app: a team of AI coding agents on one project.",
  "author": "Shubhadeep Datta <slenderisincollege@gmail.com>",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "bun test ./src ./scripts",
    "live": "bun scripts/live.ts",
    "smoke": "bun scripts/smoke.ts",
    "bundle-core": "bun scripts/bundle-core.ts",
    "dist": "bun scripts/bundle-core.ts && electron-vite build && electron-builder --mac --$(node -p process.arch)",
    "dist:dir": "bun scripts/bundle-core.ts && electron-vite build && electron-builder --mac --dir",
    "check": "npm run typecheck && bun test ./src && npm run build && bun scripts/live.ts && bun scripts/smoke.ts && bun scripts/audit.ts && bun scripts/perf.ts",
    "perf": "bun scripts/perf.ts",
    "audit": "bun scripts/audit.ts",
    "dist:all": "bun scripts/bundle-core.ts arm64 x64 && electron-vite build && electron-builder --mac --arm64 --x64"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
