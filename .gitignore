node_modules/
# anchored: unanchored `niti` matched any path component, which silently ignored
# tui/cmd/niti/ — the Go TUI's main package — so a clean clone could not build it.
/niti
/niti-core
# `go build` run inside the TUI's main package drops its binary here.
/tui/cmd/niti/niti
/npm/
*.tgz
*.log
*.log.[0-9]*
.DS_Store
.niti/agents.yaml
.niti/session.json
.niti/niti.db*
.niti/reports/
.niti/history
.env
.env.*
# eval token baseline: scripts/eval/run.ts --save-tokens base.json
/base.json
.serena/
