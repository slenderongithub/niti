{
  "name": "niti",
  "version": "0.1.0",
  "description": "A terminal CLI that runs multiple AI coding agents from different LLM providers concurrently on one project.",
  "type": "module",
  "bin": {
    "amux": "bin/amux.js",
    "amux-core": "bin/amux-core.js"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "serve": "bun run src/server/main.ts",
    "build": "bun build --compile ./src/cli.ts --outfile amux-core",
    "build:tui": "cd tui && go mod tidy && go build -o ../amux ./cmd/amux",
    "build:all": "bun run build:tui && bun run build",
    "build:release": "bun run scripts/build-release.ts",
    "test": "bun test src web",
    "typecheck": "tsc --noEmit",
    "gen:catalog": "bun run scripts/gen-catalog.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slenderongithub/amux.git"
  },
  "homepage": "https://github.com/slenderongithub/amux#readme",
  "bugs": {
    "url": "https://github.com/slenderongithub/amux/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "tui",
    "llm",
    "coding-agent",
    "multi-agent",
    "anthropic",
    "openai",
    "gemini"
  ],
  "author": "Shubhadeep Datta <slenderisincollege@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "niti-darwin-arm64": "0.1.0",
    "niti-darwin-x64": "0.1.0",
    "niti-linux-arm64": "0.1.0",
    "niti-linux-x64": "0.1.0",
    "niti-win32-x64": "0.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "@types/bun": "^1.3.14",
    "openai": "^7.0.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
