{
  "name": "amux",
  "version": "0.0.1",
  "private": true,
  "description": "A terminal CLI that runs multiple AI coding agents from different LLM providers concurrently on one project.",
  "type": "module",
  "bin": {
    "amux-core": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "serve": "bun run src/server/main.ts",
    "build": "bun build --compile ./src/cli.ts --outfile amux-core",
    "build:tui": "cd tui && go mod tidy && go build -o ../amux ./cmd/amux",
    "build:all": "bun run build:tui && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "gen:catalog": "bun run scripts/gen-catalog.ts",
    "postinstall": "bun run scripts/fix-pty-perms.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "openai": "^7.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}